{
  "manifest_version": 3,
  "name": "GemFetch",
  "version": "2.1.2",
  "description": "One click: save an AI chat (Google AI Mode/Overview, ChatGPT, Claude, Gemini, Perplexity…) as clean Markdown into a Downloads subfolder.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "tabGroups", "downloads"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GemFetch — save this chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}

{
  "manifest_version": 3,
  "name": "GemFetch",
  "version": "1.0.0",
  "description": "One click: save a Google AI Overview / AI Mode chat as Markdown, filed by Chrome tab group, with an Archive.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "tabGroups"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GemFetch — save this chat"
  },
  "options_page": "options.html"
}
